<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.netsentinel.desktop.controller.DesktopMainController"
      prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/desktop.css">

    <!-- 1. Desktop MenuBar (Syllabus Demonstration: MenuBar, Menu, MenuItem, KeyAccelerators) -->
    <MenuBar fx:id="mainMenuBar">
        <Menu text="_File">
            <MenuItem text="↻ Sync from Core" onAction="#handleRefresh" accelerator="Shortcut+R" />
            <MenuItem text="⟲ Reset Demo State" onAction="#handleResetDemo" accelerator="Shortcut+Shift+R" />
            <MenuItem text="💾 Export Incident Dossier" onAction="#handleExportDossier" accelerator="Shortcut+E" />
            <SeparatorMenuItem />
            <MenuItem text="✕ Exit" onAction="#handleExit" accelerator="Alt+F4" />
        </Menu>
        <Menu text="_View">
            <MenuItem text="🌓 Toggle Dark / Light Theme" onAction="#handleToggleTheme" accelerator="Shortcut+T" />
            <SeparatorMenuItem />
            <MenuItem text="1. Dashboard View" onAction="#handleSelectDashboardTab" accelerator="Shortcut+1" />
            <MenuItem text="2. Incident Monitor View" onAction="#handleSelectIncidentsTab" accelerator="Shortcut+2" />
            <MenuItem text="3. Threat Simulator View" onAction="#handleSelectSimulationTab" accelerator="Shortcut+3" />
            <MenuItem text="4. Event Explorer View" onAction="#handleSelectExplorerTab" accelerator="Shortcut+4" />
        </Menu>
        <Menu text="_Tools">
            <MenuItem text="⚡ Run Multithreaded Event Processor" onAction="#handleRunBatchProcessor" accelerator="Shortcut+B" />
            <MenuItem text="🧹 Clear Local Data Cache" onAction="#handleClearCache" />
        </Menu>
        <Menu text="_Help">
            <MenuItem text="ℹ About NetSentinel Desktop" onAction="#handleAbout" />
            <MenuItem text="🎓 Java Syllabus Concept Mapping" onAction="#handleSyllabusMapping" />
        </Menu>
    </MenuBar>

    <!-- 2. Desktop ToolBar (Syllabus Demonstration: ToolBar, Buttons, Separator) -->
    <ToolBar styleClass="tool-bar">
        <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
            <Button fx:id="toolbarRefreshBtn" text="↻ Refresh" styleClass="btn-outline" onAction="#handleRefresh" />
            <Button fx:id="toolbarThemeBtn" text="🌓 Theme" styleClass="btn-outline" onAction="#handleToggleTheme" />
            <Button fx:id="toolbarResetBtn" text="↺ Reset Demo" styleClass="btn-outline" onAction="#handleResetDemo" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="connectionStatusLabel" text="● CHECKING CORE ENGINE..." style="-fx-text-fill: #E6A23C; -fx-font-weight: bold; -fx-font-size: 11px;" />
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Label fx:id="healthScoreBadge" text="🛡️ Health: --" style="-fx-font-weight: bold; -fx-text-fill: #20A99A; -fx-background-color: rgba(32,169,154,0.15); -fx-padding: 4 10; -fx-background-radius: 12;" />
            <TextField fx:id="quickSearchField" promptText="🔍 Quick filter incidents..." prefWidth="210.0" onKeyPressed="#handleQuickSearchKey" />
        </HBox>
    </ToolBar>

    <!-- 3. Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="NetSentinel Desktop Security Console" styleClass="header-title" />
            <Label text="Intelligent Campus Network Anomaly Detection and Incident Analyzer" styleClass="header-sub" />
        </VBox>
        <HBox alignment="CENTER" spacing="14.0">
            <Label fx:id="threatIndexLabel" text="THREAT INDEX: --" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #9CA3AF;" />
        </HBox>
    </HBox>

    <!-- 4. Main Body Container -->
    <VBox spacing="14.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="14.0" right="18.0" bottom="14.0" left="18.0" />
        </padding>

        <!-- KPI Metrics Cards Row -->
        <HBox spacing="14.0">
            <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS">
                <Label text="TOTAL ACTIVITIES" styleClass="metric-label" />
                <Label fx:id="totalActivitiesLabel" text="--" styleClass="metric-value" />
                <Label text="Real-time Portal Events" styleClass="header-sub" />
            </VBox>
            <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS">
                <Label text="TOTAL INCIDENTS" styleClass="metric-label" />
                <Label fx:id="totalIncidentsLabel" text="--" styleClass="metric-value" />
                <Label text="Detected Anomalies" styleClass="header-sub" />
            </VBox>
            <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS">
                <Label text="HIGH / CRITICAL" styleClass="metric-label" />
                <Label fx:id="highCriticalLabel" text="--" styleClass="metric-value-danger" />
                <Label text="Immediate Action Required" styleClass="header-sub" />
            </VBox>
            <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS">
                <Label text="OPEN CASES" styleClass="metric-label" />
                <Label fx:id="openCasesLabel" text="--" style="-fx-text-fill: #E6A23C; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <Label text="Under Investigation" styleClass="header-sub" />
            </VBox>
            <VBox styleClass="metric-panel" HBox.hgrow="ALWAYS">
                <Label text="SECURITY HEALTH" styleClass="metric-label" />
                <Label fx:id="securityHealthLabel" text="--%" style="-fx-text-fill: #10B981; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <Label fx:id="securityHealthStatusLabel" text="Status: Calibrating" styleClass="header-sub" />
            </VBox>
        </HBox>

        <!-- Main Tab Pane Navigation -->
        <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

            <!-- TAB 1: EXECUTIVE DASHBOARD -->
            <Tab fx:id="tabDashboard" text="  📊 Operations Dashboard  ">
                <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS">
                    <!-- Left: Security Operations Summary & Health Diagnostics -->
                    <VBox spacing="12.0">
                        <padding>
                            <Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
                        </padding>
                        <Label text="Campus Perimeter &amp; Health Overview" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F3F4F6;" />
                        <VBox spacing="8.0" style="-fx-background-color: rgba(23,36,56,0.6); -fx-padding: 12; -fx-border-color: #2b4563; -fx-border-radius: 6; -fx-background-radius: 6;">
                            <Label text="🛡️ Transparent Security Health Formula:" style="-fx-font-weight: bold; -fx-text-fill: #20A99A;" />
                            <Label text="Score = 100 - (HighCrit × 12) - (OpenNorm × 6) - (Investigating × 4) + (Resolved × 3)" style="-fx-font-family: Consolas; -fx-text-fill: #D1D5DB; -fx-font-size: 11px;" />
                            <Label text="Deterministic scoring derived from live SQLite tables (users, activity_logs, incidents)." styleClass="header-sub" />
                        </VBox>

                        <Label text="Quick Incident Summary Ticker" style="-fx-font-weight: bold; -fx-text-fill: #9CA3AF;" />
                        <ListView fx:id="dashboardActivityListView" VBox.vgrow="ALWAYS" />
                    </VBox>

                    <!-- Right: Threat Engine Status & Quick Actions -->
                    <VBox spacing="12.0">
                        <padding>
                            <Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
                        </padding>
                        <Label text="Active Detection Engine Heuristics" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F3F4F6;" />
                        <VBox spacing="8.0" style="-fx-background-color: rgba(23,36,56,0.6); -fx-padding: 12; -fx-border-color: #2b4563; -fx-border-radius: 6; -fx-background-radius: 6;">
                            <Label text="• RULE-ATT-001: Unauthorized Attendance Modification (Active - HIGH)" style="-fx-text-fill: #E5E7EB; -fx-font-size: 12px;" />
                            <Label text="• RULE-MOD-002: Bulk Academic Record Burst Modification (Active - Sliding Window)" style="-fx-text-fill: #E5E7EB; -fx-font-size: 12px;" />
                            <Label text="• RULE-PRV-003: Unauthorized Privilege Escalation Interception (Active - CRITICAL)" style="-fx-text-fill: #E5E7EB; -fx-font-size: 12px;" />
                            <Label text="• RULE-REC-004: Unauthorized Student Record Access / IDOR (Active - HIGH)" style="-fx-text-fill: #E5E7EB; -fx-font-size: 12px;" />
                        </VBox>

                        <Label text="Demonstration Control Panel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F3F4F6;" />
                        <HBox spacing="10.0">
                            <Button text="⚡ Run All 4 Threat Simulations" styleClass="btn-action" onAction="#handleRunAllSimulations" />
                            <Button text="↺ Reset Seed Data" styleClass="btn-danger" onAction="#handleResetDemo" />
                        </HBox>
                        <TextArea fx:id="quickLogArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true" promptText="Console logs and system events will stream here..." />
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- TAB 2: INCIDENT VIEWER & DETAILS -->
            <Tab fx:id="tabIncidents" text="  🚨 Incident Viewer &amp; Dossier  ">
                <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS">
                    <!-- Left: Search Filter & TableView -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                        </padding>

                        <!-- Filter Controls (Syllabus Demonstration: TextField, ComboBox, Button, KeyEvent) -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <TextField fx:id="incidentFilterField" promptText="Filter by ID, Actor, Rule, or Title..." HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="severityComboBox" prefWidth="120.0" promptText="Severity" />
                            <Button fx:id="clearFilterBtn" text="Clear" styleClass="btn-outline" onAction="#handleClearIncidentFilter" />
                        </HBox>

                        <TableView fx:id="incidentsTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNumber" text="Incident ID" prefWidth="110.0" />
                                <TableColumn fx:id="colTitle" text="Incident Title" prefWidth="170.0" />
                                <TableColumn fx:id="colSeverity" text="Severity" prefWidth="80.0" />
                                <TableColumn fx:id="colStatus" text="Status" prefWidth="90.0" />
                                <TableColumn fx:id="colActor" text="Actor" prefWidth="95.0" />
                                <TableColumn fx:id="colRule" text="Rule Code" prefWidth="105.0" />
                                <TableColumn fx:id="colCreated" text="Detected At" prefWidth="120.0" />
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Right: Selected Incident Investigation Dossier & Event Timeline -->
                    <VBox spacing="8.0">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Incident Investigation Dossier" style="-fx-font-weight: bold; -fx-text-fill: #20A99A; -fx-font-size: 13px;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="💾 Export Dossier" styleClass="btn-outline" onAction="#handleExportDossier" />
                        </HBox>

                        <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                            <!-- Dossier Tab -->
                            <Tab text="Sentinel Insight™ XAI">
                                <TextArea fx:id="incidentDossierArea" wrapText="true" editable="false" promptText="Select an incident from the table to inspect forensic findings and Sentinel Insight explanation..." />
                            </Tab>
                            <!-- Event Timeline Tab (Syllabus Demonstration: ListView) -->
                            <Tab text="Chronological Event Timeline">
                                <ListView fx:id="incidentTimelineListView" />
                            </Tab>
                        </TabPane>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- TAB 3: THREAT SIMULATOR CONSOLE -->
            <Tab fx:id="tabSimulation" text="  ⚡ Attack Simulation Lab  ">
                <VBox spacing="14.0">
                    <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0" />
                    </padding>
                    <Label text="Interactive Cyber Threat Simulation Console" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #F3F4F6;" />
                    <Label text="Executes real Spring Boot security services against test actors, evaluating boundary policies and generating genuine incidents." styleClass="header-sub" />

                    <!-- Scenario Selection (Syllabus Demonstration: RadioButton, ToggleGroup) -->
                    <VBox spacing="10.0" style="-fx-background-color: rgba(23,36,56,0.6); -fx-padding: 14; -fx-border-color: #2b4563; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <Label text="Select Threat Scenario to Inject:" style="-fx-font-weight: bold; -fx-text-fill: #20A99A;" />

                        <RadioButton fx:id="radioSimAttendance" text="Scenario A: Unauthorized Attendance Modification (RULE-ATT-001 • HIGH)" selected="true">
                            <toggleGroup>
                                <ToggleGroup fx:id="scenarioToggleGroup" />
                            </toggleGroup>
                        </RadioButton>
                        <Label text="   Simulates an unassigned faculty member or student attempting to forge attendance for course CS301." styleClass="header-sub" />

                        <RadioButton fx:id="radioSimBulk" text="Scenario B: Bulk Academic Record Modification (RULE-MOD-002 • HIGH)" toggleGroup="$scenarioToggleGroup" />
                        <Label text="   Simulates a rapid burst velocity of grade modifications exceeding sliding-window thresholds." styleClass="header-sub" />

                        <RadioButton fx:id="radioSimPrivilege" text="Scenario C: Unauthorized Privilege Escalation (RULE-PRV-003 • CRITICAL)" toggleGroup="$scenarioToggleGroup" />
                        <Label text="   Simulates a non-administrative account attempting to elevate role permissions or alter account status." styleClass="header-sub" />

                        <RadioButton fx:id="radioSimAccess" text="Scenario D: Unauthorized Student Record Access / IDOR (RULE-REC-004 • HIGH)" toggleGroup="$scenarioToggleGroup" />
                        <Label text="   Simulates student101 attempting horizontal traversal to access confidential records of student102." styleClass="header-sub" />
                    </VBox>

                    <!-- Actor & Execution Row (Syllabus Demonstration: ComboBox, Button, Task) -->
                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                        <Label text="Test Actor Account:" style="-fx-font-weight: bold; -fx-text-fill: #D1D5DB;" />
                        <ComboBox fx:id="simActorComboBox" prefWidth="180.0" promptText="Select Actor" />
                        <Button fx:id="btnRunSimulation" text="🚀 Inject Attack Vector &amp; Run Engine" styleClass="btn-danger" onAction="#handleRunSelectedSimulation" />
                        <Button text="↺ Reset State" styleClass="btn-outline" onAction="#handleResetDemo" />
                    </HBox>

                    <!-- Simulation Result Console -->
                    <VBox VBox.vgrow="ALWAYS" spacing="6.0">
                        <Label text="Engine Simulation Verdict &amp; Telemetry Payload:" style="-fx-font-weight: bold; -fx-text-fill: #9CA3AF;" />
                        <TextArea fx:id="simulationOutputArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true" promptText="Select a scenario and click 'Inject Attack Vector' to execute live backend heuristics..." />
                    </VBox>
                </VBox>
            </Tab>

            <!-- TAB 4: EVENT EXPLORER & MULTITHREADING (Syllabus Demonstration: TreeView, Multithreaded Processor) -->
            <Tab fx:id="tabExplorer" text="  🌳 Event Explorer &amp; Batch Processor  ">
                <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
                    <!-- Left: Hierarchical Event Taxonomy TreeView -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                        </padding>
                        <Label text="Hierarchical Telemetry Taxonomy" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #F3F4F6;" />
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <TextField fx:id="treeSearchField" promptText="Search telemetry nodes..." HBox.hgrow="ALWAYS" />
                            <Button text="Expand All" styleClass="btn-outline" onAction="#handleExpandTree" />
                        </HBox>
                        <!-- TreeView Control -->
                        <TreeView fx:id="eventTaxonomyTreeView" VBox.vgrow="ALWAYS" />
                    </VBox>

                    <!-- Right: Multithreaded Batch Processor & Raw Activity Stream -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                        </padding>
                        <Label text="Multithreaded Background Event Processor" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #20A99A;" />
                        <Label text="Demonstrates Producer-Consumer pattern using ExecutorService, BlockingQueue, and synchronized buffers." styleClass="header-sub" />

                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Button fx:id="btnRunBatch" text="⚡ Execute Batch Stream (Worker Threads)" styleClass="btn-action" onAction="#handleRunBatchProcessor" />
                            <ProgressBar fx:id="batchProgressBar" prefWidth="180.0" progress="0.0" />
                        </HBox>

                        <TextArea fx:id="batchOutputArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true" promptText="Multithreaded batch processing results and inter-thread summary packets will display here..." />
                    </VBox>
                </SplitPane>
            </Tab>

        </TabPane>
    </VBox>
</VBox>
